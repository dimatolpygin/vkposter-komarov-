# Скопировать в .env и заполнить. Файл .env в git не попадает.
#
# Проект живёт на общем сервере okhost (навык /okdeploy2). Реквизиты БД сюда НЕ пишутся:
# они приходят из соседнего файла .env.infra, который генерит `okhost new` и который
# docker compose подключает первым. POSTGRES_* ниже нужны только для локального запуска
# со своим Postgres (docker-compose.dev.yml) — на сервере их в .env быть не должно.

# --- окружение ---
NODE_ENV=development
APP_PORT=3000
LOG_LEVEL=debug
LOG_PRETTY=true
# Базовый URL, по которому система доступна извне. Нужен с этапа 5:
# postmypost сам скачивает картинку по этому адресу, поэтому на проде — https-домен.
PUBLIC_BASE_URL=http://localhost:3000
# Домен проекту выдаёт общий Caddy сервера, отдельной переменной он не требует:
#   okhost web komarov-vkposter vktop545.com 3000
# Сертификат Let's Encrypt Caddy выпускает сам, A-запись домена уже должна
# указывать на 193.17.95.54.

# --- Postgres: ТОЛЬКО для локального запуска ---
# На сервере эти переменные приходят из .env.infra и здесь их быть не должно.
POSTGRES_USER=vkposter
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=vkposter
# Порт, на котором БД видна с хоста в dev (внутри сети всегда 5432)
POSTGRES_EXPOSED_PORT=5433

# --- панель управления (этап 1) ---
# Логин и стартовый пароль админа. При первом запуске пароль хешируется и уходит в БД,
# дальше меняется в панели. Здесь — только первичная установка.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me_on_first_login

# Адрес журнала сбоев. Раздел «Ошибки» показывает тела ответов провайдеров, клиенту
# в панели это не нужно, а вход в панель один на всех. Своя строка убирает раздел из
# меню и с обзора: журнал открывается только по прямому адресу /<DIAG_PATH>.
# Пусто или errors — раздел остаётся на /errors и виден в меню (удобно локально).
DIAG_PATH=errors
# Секрет для подписи cookie сессии (любая длинная случайная строка)
SESSION_SECRET=change_me_random_long_string

# --- postmypost: публикация в ВК (этап 6) ---
# Как и у kie.ai, в dev базовый URL можно подменить на локальную заглушку и прогнать
# публикацию, не создавая настоящих черновиков и постов в проекте клиента:
# POSTMYPOST_BASE_URL=http://127.0.0.1:3000/_debug/pmp
POSTMYPOST_BASE_URL=https://api.postmypost.io/v4.1
POSTMYPOST_TOKEN=
POSTMYPOST_PROJECT_ID=
# Таймаут ОДНОГО запроса. Ожидание загрузки картинки задаётся в настройках панели
# (pmp_upload_wait_ms), потому что идёт поллингом.
POSTMYPOST_TIMEOUT_MS=30000

# --- OpenRouter: генерация текста (этап 4) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-v4-flash:nitro
# Базовый URL провайдера. В dev можно подменить на локальную заглушку, чтобы прогнать
# конвейер генерации без расхода кредитов:
# OPENROUTER_BASE_URL=http://127.0.0.1:3000/_debug/openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=120000

# --- kie.ai: генерация обложек (этап 5) ---
KIE_API_KEY=
# Короткое имя модели; суффикс режима (-text-to-image) клиент дописывает сам
KIE_MODEL=gpt-image-2
# Как и у openrouter, в dev можно подменить на локальную заглушку и проверить
# таймауты, нулевые кредиты и провал задачи, не расходуя кредиты:
# KIE_BASE_URL=http://127.0.0.1:3000/_debug/kie
KIE_BASE_URL=https://api.kie.ai/api/v1
# Таймаут ОДНОГО запроса к kie.ai. Ожидание самой картинки задаётся в настройках
# панели (kie_wait_ms), потому что генерация идёт поллингом и длится минуты.
KIE_TIMEOUT_MS=60000
# Куда складываются обложки. В контейнере это том media, менять не нужно.
MEDIA_DIR=/app/media

# --- firecrawl: извлечение текста статей (этап 2) ---
FIRECRAWL_API_KEY=
